{
  "name": "directus-extension-clicktrail",
  "version": "0.1.0-rc.3",
  "description": "First-party attribution and conversion tracking for Directus: a Flow operation to send ClickTrail events, an API hook that attaches attribution signals on collection creates, a Campaign -> Lead -> Sale dashboard panel, and a settings module.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/api/index.js",
  "types": "./dist/api/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "directus-extension",
    "directus",
    "flow",
    "attribution",
    "analytics",
    "first-party-data",
    "conversion-tracking",
    "consent",
    "dashboard"
  ],
  "directus": {
    "host": "^10 || ^11",
    "type": [
      "operation",
      "hook",
      "panel",
      "module"
    ],
    "sandbox": {
      "enabled": false,
      "requestedScopes": {}
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vizuh/clicktrail-js.git",
    "directory": "integrations/directus"
  },
  "homepage": "https://github.com/vizuh/clicktrail-js/tree/main/packages/directus#readme",
  "bugs": {
    "url": "https://github.com/vizuh/clicktrail-js/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-app.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@vizuh/clicktrail": "workspace:^",
    "@vizuh/clicktrail-core": "workspace:^",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0",
    "vitest": "^3.2.6"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
