{
  "name": "@vizuh/clicktrail-sv",
  "version": "0.1.0-rc.4",
  "description": "Experimental Svelte CLI add-on that scaffolds the ClickTrail SvelteKit hook, layout, environment placeholder, and example event endpoint.",
  "license": "MIT",
  "author": "Vizuh OÜ",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "UPSTREAM-ISSUE-DRAFT.md"
  ],
  "keywords": [
    "svelte",
    "sveltekit",
    "sv-addon",
    "community-addon",
    "clicktrail",
    "attribution",
    "analytics",
    "conversion-tracking"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vizuh/clicktrail-js.git",
    "directory": "integrations/sv"
  },
  "homepage": "https://github.com/vizuh/clicktrail-js/tree/master/integrations/sv#readme",
  "bugs": {
    "url": "https://github.com/vizuh/clicktrail-js/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@vizuh/clicktrail-sveltekit": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
