{
  "name": "@vizuh/clicktrail-astro",
  "version": "0.1.0-rc.3",
  "description": "First-party attribution and conversion tracking for Astro. Injects the ClickTrail browser SDK, tracks page views across Astro view transitions without duplicates, gates on consent, adds an optional first-party proxy endpoint, and ships server-side helpers for leads, bookings, and purchases.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./proxy": {
      "types": "./dist/proxy.d.ts",
      "default": "./dist/proxy.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "astro",
    "astro-integration",
    "withastro",
    "attribution",
    "analytics",
    "first-party-analytics",
    "conversion-tracking",
    "utm",
    "gclid",
    "fbclid",
    "first-touch",
    "last-touch",
    "view-transitions",
    "consent",
    "gdpr",
    "marketing",
    "click-id"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vizuh/clicktrail-js.git",
    "directory": "integrations/astro"
  },
  "homepage": "https://github.com/vizuh/clicktrail-js/tree/main/packages/astro#readme",
  "bugs": {
    "url": "https://github.com/vizuh/clicktrail-js/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@vizuh/clicktrail": "workspace:^",
    "@vizuh/clicktrail-core": "workspace:^"
  },
  "peerDependencies": {
    "astro": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
