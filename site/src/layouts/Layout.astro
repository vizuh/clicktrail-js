---
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
  /** Path portion of the canonical URL, e.g. "/how-it-works/". */
  canonicalPath?: string;
  ogType?: 'website' | 'article';
  /** Home page only: Organization + SoftwareApplication JSON-LD. */
  jsonLd?: boolean;
}

const { title, description, canonicalPath = '/', ogType = 'website', jsonLd = false } = Astro.props;

// TODO: PLACEHOLDER DOMAIN — swap `site` in astro.config.mjs and this base
// when the production domain is live.
const siteBase = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://clicktrail.dev';
const canonicalUrl = `${siteBase}${canonicalPath}`;

const repoUrl = 'https://github.com/vizuh/clicktrail-js';
const npmCore = 'https://www.npmjs.com/package/@vizuh/clicktrail';
const wpPlugin = 'https://wordpress.org/plugins/click-trail-handler/';

const jsonLdPayload = jsonLd
  ? {
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'Organization',
          name: 'Vizuh OÜ',
          url: 'https://vizuh.com',
        },
        {
          '@type': 'SoftwareApplication',
          name: 'ClickTrail',
          applicationCategory: 'DeveloperApplication',
          operatingSystem: 'Web, Node.js, Python',
          license: 'https://opensource.org/licenses/MIT',
          author: { '@type': 'Organization', name: 'Vizuh OÜ' },
          codeRepository: repoUrl,
          description:
            'Deterministic first-party attribution engine. Captures the trail from ad click to conversion.',
        },
      ],
    }
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href="/clicktrail-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="ClickTrail" />

    <!-- Twitter card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    {jsonLdPayload && <script type="application/ld+json" set:html={JSON.stringify(jsonLdPayload)} />}

    <!--
      ClickTrail self-tracking (fallback path): the @vizuh/clicktrail-astro client
      hardcodes an HTTP destination, which has nowhere to deliver on a static
      host. This site instead boots the prebuilt global bundle with a GTM
      dataLayer destination so its own page views are observable in-page.
      See README.md.
    -->
    <script is:inline src="/clicktrail.global.js"></script>
    <script is:inline>
      (() => {
        const CT = window.ClickTrail;
        if (!CT) return;

        window.dataLayer = window.dataLayer || [];

        const consoleDestination = {
          name: 'console',
          deliver(event) {
            console.info('[clicktrail]', event.event_name ?? event.name ?? 'event', event);
          },
        };

        const clickTrail = CT.createClickTrail({
          siteId: 'clicktrail-site',
          destinations: [CT.dataLayerDestination({ dataLayer: window.dataLayer }), consoleDestination],
          storage: {
            cookieAttrs: { path: '/', sameSite: 'Lax', secure: true },
          },
        });

        clickTrail.start();

        // Page views across full loads and Astro-style view transitions,
        // mirroring attachPageViewTracking from @vizuh/clicktrail-astro:
        // URL-keyed dedupe, first-touch preserved / last-touch merged.
        let lastKey = null;
        const trackView = () => {
          const key = location.pathname + location.search;
          if (key === lastKey) return;
          lastKey = key;

          const result = CT.parseAttributionUrl({
            url: location.href,
            ...(document.referrer ? { referrer: document.referrer } : {}),
            currentHost: location.host,
            now: new Date().toISOString(),
          });
          if (result.kind === 'touch') {
            clickTrail.mergeParsedTouch(result.touch);
          }
          clickTrail.track('page_view', { page_location: location.href });
        };

        trackView();
        document.addEventListener('astro:page-load', trackView);
      })();
    </script>
  </head>
  <body>
    <header class="nav">
      <div class="wrap nav-inner">
        <a class="brand" href="/">
          <img src="/clicktrail-icon.png" alt="" width="30" height="30" />
          Click<strong>Trail</strong>
        </a>
        <nav class="nav-links">
          <a href="/">Product</a>
          <a href="/how-it-works/">How it works</a>
          <a href="/integrations/">Integrations</a>
          <a href="/event-contract/">Event contract</a>
          <a href="/compare/">Compare</a>
          <a href="/open-source/">Open source</a>
          <a href={repoUrl}>GitHub</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap footer-grid">
        <div class="footer-col">
          <p class="footer-head">ClickTrail</p>
          <nav class="footer-links footer-stack">
            <a href="/">Home</a>
            <a href="/how-it-works/">How it works</a>
            <a href="/event-contract/">Event contract</a>
            <a href="/compare/">Compare</a>
            <a href="/open-source/">Open source</a>
          </nav>
        </div>
        <div class="footer-col">
          <p class="footer-head">Integrations</p>
          <nav class="footer-links footer-stack">
            <a href="/integrations/">All integrations</a>
            <a href="/integrations/astro/">Astro</a>
            <a href="/integrations/nuxt/">Nuxt</a>
            <a href="/integrations/n8n/">n8n</a>
            <a href="/integrations/directus/">Directus</a>
            <a href="/integrations/python-sdk/">Python SDK</a>
            <a href="/integrations/wordpress/">WordPress</a>
          </nav>
        </div>
        <div class="footer-col">
          <p class="footer-head">Project</p>
          <nav class="footer-links footer-stack">
            <a href={repoUrl}>GitHub repository</a>
            <a href={`${repoUrl}/issues`}>Issue tracker</a>
            <a href={npmCore}>@vizuh/clicktrail on npm</a>
            <a href={wpPlugin}>WordPress plugin</a>
            <a href={`${repoUrl}/security/advisories/new`}>Security policy</a>
          </nav>
        </div>
      </div>
      <div class="wrap footer-line">
        <span>Vizuh O&Uuml; &middot; MIT license &middot; The WordPress plugin is GPL-2.0-or-later.</span>
      </div>
    </footer>
  </body>
</html>
