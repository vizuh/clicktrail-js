---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page not found — ClickTrail"
  description="This ClickTrail page does not exist. Head back to the home page or browse the integrations hub."
  canonicalPath="/404.html"
>
  <section class="hero">
    <div class="wrap">
      <p class="kicker">404</p>
      <h1>This trail leads nowhere.</h1>
      <p class="lede">
        The page you asked for does not exist on this site.
      </p>
      <div class="cta-row">
        <a class="btn btn-primary" href="/">Back to home</a>
        <a class="btn btn-secondary" href="/integrations/">Integrations hub</a>
      </div>
    </div>
  </section>
</Layout>
