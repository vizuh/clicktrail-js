---
import Layout from '../layouts/Layout.astro';
import { integrations } from '../data/integrations';

const featured = ['astro', 'nuxt', 'n8n', 'directus', 'python-sdk', 'wordpress']
  .map((slug) => integrations.find((i) => i.slug === slug))
  .filter((i): i is NonNullable<typeof i> => Boolean(i));

const canonicalEvents = [
  'page_view',
  'form_started',
  'lead_created',
  'lead_qualified',
  'booking_created',
  'booking_completed',
  'sale',
  'refund',
  'consent_updated',
];
---

<Layout
  title="ClickTrail — first-party attribution you own"
  description="Deterministic, consent-gated, first-party attribution. Know which ad made the sale, and keep the data on your infrastructure."
  canonicalPath="/"
  jsonLd={true}
>
  <!-- hero -->
  <section class="hero">
    <div class="wrap">
      <p class="kicker">First-party attribution engine</p>
      <h1>Know which ad made the sale.<br />Keep the data on <span class="accent">your infrastructure</span>.</h1>
      <p class="lede">
        ClickTrail captures UTMs and ad click IDs on the landing page, merges
        first-touch and last-touch into one flat canonical payload, and carries
        the full trail into every conversion. Deterministic engine,
        consent-gated by design, entirely first-party.
      </p>
      <div class="cta-row">
        <a class="btn btn-primary" href="/how-it-works/">How it works</a>
        <a class="btn btn-secondary" href="/integrations/">Browse integrations</a>
      </div>
    </div>
  </section>

  <!-- trust strip -->
  <section class="section" aria-label="Trust facts">
    <div class="wrap">
      <div class="trust">
        <div class="trust-item"><strong>MIT licensed</strong><span>Open source core. The WordPress plugin remains GPL-2.0-or-later.</span></div>
        <div class="trust-item"><strong>Provenance published</strong><span>The event contract publishes ownership, release, compatibility, and issue-tracker requirements for every integration.</span></div>
        <div class="trust-item"><strong>Deterministic &amp; tested</strong><span>Golden fixtures captured from the live WordPress plugin are replayed in CI.</span></div>
        <div class="trust-item"><strong>Self-hosted</strong><span>Payloads land in systems you control. No third-party cookies, no vendor-owned IDs.</span></div>
      </div>
    </div>
  </section>

  <!-- how it works -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="kicker">How it works</p>
        <h2>From ad click to conversion, one trail</h2>
        <p>
          The same deterministic engine that powers the WordPress plugin runs
          anywhere Node or a browser runs. Same inputs always produce the same
          payload &mdash; time, IDs, storage, consent, and network are injected,
          never requested. <a href="/how-it-works/">Read the pipeline deep-dive.</a>
        </p>
      </div>
      <div class="steps">
        <article class="step">
          <span class="step-num">01</span>
          <h3>Capture</h3>
          <p>
            On landing, ClickTrail parses UTMs, ad click IDs
            (<code>gclid</code>, <code>fbclid</code>, <code>ttclid</code>,
            ...), and referrer classification into an attribution touch.
          </p>
        </article>
        <article class="step">
          <span class="step-num">02</span>
          <h3>Merge</h3>
          <p>
            First touch is preserved, last touch is updated, and both collapse
            into one flat canonical payload with
            <code>ft_*</code> and <code>lt_*</code> fields.
          </p>
        </article>
        <article class="step">
          <span class="step-num">03</span>
          <h3>Convert</h3>
          <p>
            Lead, booking, and purchase events carry the full trail &mdash;
            attribution, click IDs, consent state, and form context ride along
            on every conversion.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- featured integrations -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="kicker">Integrations</p>
        <h2>One engine, every platform you run</h2>
        <p>
          Frameworks, automation tools, commerce stacks, server languages, and
          the WordPress plugin the engine was extracted from.
          <a href="/integrations/">See all {integrations.length} integrations.</a>
        </p>
      </div>
      <div class="int-grid">
        {featured.map((item) => (
          <a class="int-card" href={`/integrations/${item.slug}/`}>
            <div class="int-card-head">
              <h3>{item.name}</h3>
              <span class={`badge badge-${item.status}`}>{item.status === 'rc' ? 'RC' : item.status}</span>
            </div>
            <p>{item.summary}</p>
            <code>{item.installCommand}</code>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- canonical events preview -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="kicker">Event contract</p>
        <h2>Nine canonical events. No integration invents its own schema.</h2>
        <p>
          Every integration produces the same small set of canonical events
          through one shared library layer. Each event carries an
          <code>event_id</code> minted once per logical occurrence; collectors
          treat duplicates within the retention window as a success no-op.
          <a href="/event-contract/">Read the full contract.</a>
        </p>
      </div>
      <div class="event-chips">
        {canonicalEvents.map((name) => <code class="chip">{name}</code>)}
      </div>
    </div>
  </section>

  <!-- comparison -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="kicker">Why not just GA4?</p>
        <h2>Client-side tags vs. owned trails</h2>
        <p>
          ClickTrail compared with GA4's client-side tag and generic server-side tagging.
          <a href="/compare/">Full comparison page.</a>
        </p>
      </div>
      <div class="compare-wrap">
        <table class="compare">
          <thead>
            <tr>
              <th scope="col"></th>
              <th scope="col">GA4 (client-side)</th>
              <th scope="col">Server-side tagging</th>
              <th scope="col">ClickTrail</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">Data ownership</th>
              <td>Google property; sampled and modeled reporting</td>
              <td>Yours, but routed through a vendor container</td>
              <td>Your infrastructure; flat payloads you store and replay</td>
            </tr>
            <tr>
              <th scope="row">Determinism</th>
              <td>Modeling and thresholds change reported numbers</td>
              <td>Depends on the tagging setup</td>
              <td>Same inputs produce the same output, verified by golden fixtures</td>
            </tr>
            <tr>
              <th scope="row">Consent handling</th>
              <td>Consent mode signals to Google</td>
              <td>You wire it yourself</td>
              <td>Built-in gate: nothing starts or persists before grant</td>
            </tr>
            <tr>
              <th scope="row">Ad-blocker resilience</th>
              <td>Tag commonly blocked</td>
              <td>First-party endpoint helps</td>
              <td>Capture happens on your own origin; optional first-party proxy</td>
            </tr>
            <tr>
              <th scope="row">Cost model</th>
              <td>Free tier, then GA360 pricing</td>
              <td>Per-event container costs</td>
              <td>Open source (MIT); you run the storage</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="kicker">Get started</p>
        <h2>Install the engine, own the trail</h2>
        <p>The core is pure TypeScript with zero required configuration to start parsing. Python SDK available for server stacks.</p>
      </div>
      <div class="cta-row">
        <a class="btn btn-primary" href="https://github.com/vizuh/clicktrail-js#quick-start">Quick start on GitHub</a>
        <a class="btn btn-secondary" href="https://www.npmjs.com/package/@vizuh/clicktrail">@vizuh/clicktrail on npm</a>
        <a class="btn btn-secondary" href="/open-source/">License &amp; governance</a>
      </div>
    </div>
  </section>
</Layout>
