{
  "name": "clicktrail-js",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @vizuh/clicktrail... build && pnpm -r exec tsc -p tsconfig.json --noEmit",
    "build:global": "pnpm --filter @vizuh/clicktrail build:global",
    "test": "pnpm -r test",
    "probe": "pnpm --filter @vizuh/clicktrail... build && pnpm --filter @vizuh/clicktrail build:global && node probe/run-probe.mjs && node probe/run-wordpress-reference.mjs",
    "parity": "node tools/wp-runtime/run-parity.mjs",
    "verify:workspace": "node tools/ci/verify-workspace-contract.mjs"
  },
  "pnpm": {
    "overrides": {
      "form-data": "4.0.6",
      "sharp": "^0.35.5",
      "astro": "7.4.2",
      "astro>js-yaml": "4.3.2",
      "@sveltejs/kit>cookie": "0.7.2",
      "nuxt": "4.6.2",
      "undici@>=8.0.0 <8.12.2": "^8.12.2",
      "brace-expansion@>=2.0.0 <2.1.6": "^2.1.6",
      "brace-expansion@>=4.0.0 <5.0.11": "^5.0.11",
      "source-map-js@<1.2.2": "^1.2.2",
      "shell-quote@<1.11.0": "^1.11.0",
      "launch-editor@<2.14.2": "^2.14.2",
      "vite@<6.4.4": "^6.4.5"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-86w9-cpqp-85rv",
        "GHSA-mrhx-c7xc-m3w5"
      ]
    }
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "typescript": "^5.6.0"
  }
}
