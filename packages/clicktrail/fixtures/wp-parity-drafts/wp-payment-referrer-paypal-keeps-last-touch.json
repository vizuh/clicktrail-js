{
  "name": "wp-payment-referrer-paypal-keeps-last-touch",
  "description": "PayPal return (referrer only, www. subdomain) over a stored Google Ads touch: the listed payment host counts like a same-site referrer, so no touch forms and the stored last touch is kept.",
  "quirk_decision": "CONTRACT (WP plugin 1.11.0 parity, issue #43): a referrer on an ignoredReferrerHosts host or subdomain never forms a touch. Semver: additive opt-in input (minor); no default list ships, so CLASSIFIER_VERSION is unchanged.",
  "stored": {
    "ft_source": "google",
    "ft_medium": "cpc",
    "ft_campaign": "brand",
    "ft_landing_page": "https://shop.example.com/?utm_source=google&utm_medium=cpc&utm_campaign=brand&gclid=GSYNTH-PAID",
    "ft_touch_timestamp": "2026-10-23T09:00:00.000Z",
    "ft_channel": "Google Ads",
    "ft_gclid": "GSYNTH-PAID",
    "lt_source": "google",
    "lt_medium": "cpc",
    "lt_campaign": "brand",
    "lt_landing_page": "https://shop.example.com/?utm_source=google&utm_medium=cpc&utm_campaign=brand&gclid=GSYNTH-PAID",
    "lt_touch_timestamp": "2026-10-23T09:00:00.000Z",
    "lt_channel": "Google Ads",
    "lt_gclid": "GSYNTH-PAID",
    "gclid": "GSYNTH-PAID"
  },
  "input": {
    "url": "https://shop.example.com/checkout/order-received/1001/?key=wc_order_synthetic",
    "referrer": "https://www.paypal.com/checkoutnow?token=SYNTHETIC",
    "currentHost": "shop.example.com",
    "now": "2026-10-23T10:05:00.000Z",
    "ignoredReferrerHosts": [
      "paypal.com",
      "stripe.com",
      "mollie.com",
      "squareup.com",
      "square.link",
      "klarna.com",
      "adyen.com",
      "checkout.com",
      "mercadopago.com",
      "mercadopago.com.br",
      "pagseguro.uol.com.br"
    ]
  },
  "expected": {
    "_no_touch_reason": "ignored_referrer",
    "lt_source": "google",
    "lt_medium": "cpc",
    "lt_campaign": "brand",
    "lt_landing_page": "https://shop.example.com/?utm_source=google&utm_medium=cpc&utm_campaign=brand&gclid=GSYNTH-PAID",
    "lt_touch_timestamp": "2026-10-23T09:00:00.000Z",
    "lt_channel": "Google Ads",
    "lt_gclid": "GSYNTH-PAID"
  }
}
