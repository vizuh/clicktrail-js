{
  "name": "@vizuh/clicktrail",
  "version": "0.1.0-rc.3",
  "description": "Deterministic first-party attribution conventions and engine. Captures the trail from ad click to conversion.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "default": "./dist/browser/index.js"
    },
    "./conversation": {
      "types": "./dist/conversation/index.d.ts",
      "default": "./dist/conversation/index.js"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "default": "./dist/agent/index.js"
    },
    "./otel": {
      "types": "./dist/otel/index.d.ts",
      "default": "./dist/otel/index.js"
    },
    "./apointoo": {
      "types": "./dist/apointoo/index.d.ts",
      "default": "./dist/apointoo/index.js"
    },
    "./incubating": {
      "types": "./dist/incubating.d.ts",
      "default": "./dist/incubating.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "attribution",
    "utm",
    "gclid",
    "fbclid",
    "first-touch",
    "last-touch",
    "analytics",
    "marketing",
    "conversion-tracking",
    "consent",
    "first-party-data",
    "click-id",
    "cross-domain-tracking",
    "browser-sdk",
    "typescript",
    "wordpress",
    "woocommerce",
    "google-tag-manager"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vizuh/clicktrail-js.git"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:global": "esbuild src/global-entry.ts --bundle --format=iife --outfile=dist/clicktrail.global.js",
    "test": "vitest run --config vitest.config.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "fast-check": "^3.22.0",
    "typescript": "^5.6.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "directories": {
    "test": "tests"
  },
  "author": "",
  "bugs": {
    "url": "https://github.com/vizuh/clicktrail-js/issues"
  },
  "homepage": "https://github.com/vizuh/clicktrail-js#readme",
  "dependencies": {
    "@vizuh/clicktrail-browser": "workspace:^",
    "@vizuh/clicktrail-core": "workspace:^"
  }
}
