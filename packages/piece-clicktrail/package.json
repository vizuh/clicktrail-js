{
  "name": "@clicktrail/piece-clicktrail",
  "version": "0.1.0-rc.2",
  "description": "Activepieces piece for ClickTrail: translate automation inputs into schema-stamped, attribution-aware first-party events (leads, bookings, sales, refunds, consent) via the @vizuh/clicktrail SDK.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "activepieces",
    "automation",
    "attribution",
    "analytics",
    "first-party-data",
    "conversion-tracking",
    "leads",
    "bookings",
    "consent",
    "low-code"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vizuh/clicktrail-js.git",
    "directory": "packages/piece-clicktrail"
  },
  "homepage": "https://github.com/vizuh/clicktrail-js/tree/main/packages/piece-clicktrail#readme",
  "bugs": {
    "url": "https://github.com/vizuh/clicktrail-js/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@activepieces/pieces-common": "^0.12.5",
    "@activepieces/pieces-framework": "^0.32.0",
    "@activepieces/shared": "^0.96.2",
    "@vizuh/clicktrail": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.6"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
